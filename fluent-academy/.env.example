# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fluent:fluent_dev_password@localhost:5432/fluent_academy"
APP_URL="http://localhost:3000"
# 32+ random characters; used to key IP hashes. Generate: openssl rand -base64 32
APP_SECRET=""
# Comma-separated emails that receive the ADMIN role when they sign up
ADMIN_EMAILS=""
LOG_LEVEL="info"

# ── Email (password recovery) ────────────────────────────────────────────────
# Without SMTP_URL, development writes emails to storage/dev-mailbox (see /dev/mailbox);
# production refuses to send reset links until SMTP is configured.
SMTP_URL=""            # e.g. smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Fluent Academy <no-reply@example.com>"

# ── AI coach (server-side only; never exposed to the browser) ────────────────
AI_PROVIDER="auto"     # auto | anthropic | openai | practice
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="low" # low | medium | high
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, OpenRouter, Ollama, vLLM…)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# ── Speech ───────────────────────────────────────────────────────────────────
STT_PROVIDER="auto"            # auto | local | openai | azure | mock (tests only)
PRONUNCIATION_PROVIDER="auto"  # auto | azure | none
TTS_PROVIDER="auto"            # auto | local | openai | none
# Self-hosted speech service (services/speech): Whisper STT + Piper TTS
SPEECH_SERVICE_URL=""          # e.g. http://127.0.0.1:8090
SPEECH_SERVICE_TOKEN=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""         # e.g. westeurope
FFMPEG_PATH="ffmpeg"

# ── Storage ──────────────────────────────────────────────────────────────────
RECORDINGS_DIR="./storage/recordings"
TTS_CACHE_DIR="./storage/tts"
RECORDING_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=5242880
# Serve curriculum audio from a CDN/bucket instead of /public/audio
AUDIO_BASE_URL=""
NEXT_PUBLIC_AUDIO_BASE_URL=""

# ── Billing ──────────────────────────────────────────────────────────────────
BILLING_MODE="auto"            # auto | stripe | simulation | disabled
ALLOW_SIMULATED_BILLING="false" # never enable in a real production deployment
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""
